[Unit]
Description=DeepSeekCostPanel Admin Panel
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/DeepSeekCostPanel
EnvironmentFile=/home/ubuntu/DeepSeekCostPanel/deploy/deepseek-admin-panel.env
ExecStart=/usr/bin/python3 /home/ubuntu/DeepSeekCostPanel/backend/run_admin_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
