# Web 管理后台（第一阶段 MVP）
ADMIN_PANEL_MASTER_KEY=
# 推荐优先使用完整 PostgreSQL 连接串，例如：
# postgresql+psycopg://postgres:your_password@127.0.0.1:5432/deepseek_cost_panel
ADMIN_PANEL_DATABASE_URL=
# 如果不想写完整连接串，也可以分别配置下面这些变量；仅当 ADMIN_PANEL_DATABASE_URL 为空时生效
ADMIN_PANEL_PG_HOST=127.0.0.1
ADMIN_PANEL_PG_PORT=5432
ADMIN_PANEL_PG_USER=postgres
ADMIN_PANEL_PG_PASSWORD=
ADMIN_PANEL_PG_DATABASE=deepseek_cost_panel
ADMIN_PANEL_TOKEN_TTL_HOURS=24
ADMIN_PANEL_RUN_POLL_INTERVAL_SECONDS=5
