# ===== 必填：DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 必填：OKX =====
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_SIMULATED_TRADING=1

# ===== 交易参数 =====
# 默认前10个主流币候选池；程序会优先选择高置信度 BUY 信号进行模拟盘开仓
OKX_SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT,XRP-USDT,DOGE-USDT,ADA-USDT,AVAX-USDT,LINK-USDT,LTC-USDT,BCH-USDT
OKX_BAR=1H
OKX_LIMIT=200
OKX_TD_MODE=cash
OKX_TRADE_QUOTE=15
OKX_SPOT_TGT_CCY=quote_ccy
OKX_CONF_THRESHOLD=74
OKX_LOOP_SECONDS=180
OKX_STOP_LOSS_PCT=0.03
OKX_TRAILING_STOP_PCT=0.02
OKX_TRAILING_ACTIVATE_PCT=0.05
# 预估双边手续费+滑点成本（例如 0.003 = 0.30%）
OKX_ESTIMATED_ROUND_TRIP_COST_PCT=0.003
# 买入前显式预留单边成本缓冲（例如 0.0015 = 0.15%）
OKX_ENTRY_COST_BUFFER_PCT=0.0015
# 开仓前要求的最小预估净收益（基于 target_price 扣除双边成本后）
OKX_MIN_NET_PROFIT_PCT=0.01
OKX_EXIT_ON_AI_SELL=1
OKX_DYNAMIC_POSITION_ENABLED=1
OKX_MARKET_QUALITY_THRESHOLD=0.64
OKX_DYNAMIC_MIN_FACTOR=0.7
OKX_DYNAMIC_MAX_FACTOR=1.5
OKX_MAX_TOTAL_EXPOSURE_RATIO=0.70
OKX_MAX_SINGLE_ASSET_WEIGHT=0.35
OKX_MAX_ORDER_CASH_RATIO=0.20
OKX_MIN_CASH_RESERVE_RATIO=0.10
OKX_SYNC_POSITIONS_ON_START=1
OKX_DECISION_HISTORY_LIMIT=300

# ===== 分析参数（可选） =====
ANALYZER_CACHE_TTL_MINUTES=30
ANALYZER_MIN_SIGNAL_QUALITY=0.5
ANALYZER_MIN_INTERVAL_MINUTES=15
ANALYZER_MAX_OUTPUT_TOKENS=200
ANALYZER_TEMPERATURE=0.5
# 单次最多携带多少个标的发给大模型；10 个标的配 4 会拆成 4+4+2 三批
ANALYZER_BATCH_SYMBOLS_PER_REQUEST=4
ANALYZER_DAILY_BUDGET=
BUDGET_ENFORCEMENT=warn
ANALYZER_BATCH_PARSE_FALLBACK_SINGLE=1
ANALYZER_BATCH_PARSE_FALLBACK_LIMIT=10

# ===== 日志参数（可选） =====
AUTOTRADE_LOG_FILE=/home/ubuntu/DeepSeekCostPanel/logs/autotrade.log
AUTOTRADE_LOG_LEVEL=INFO
AUTOTRADE_LOG_MAX_BYTES=10485760
AUTOTRADE_LOG_BACKUP_COUNT=5

# ===== OKX 网络参数（按需设置） =====
# OKX_BASE_URL=
# OKX_BASE_URLS=https://www.okx.com,https://okx.com
# OKX_TIMEOUT=15
# OKX_RETRIES=1
# OKX_TRUST_ENV=1
# OKX_HTTPS_PROXY=
# OKX_HTTP_PROXY=
# OKX_ALL_PROXY=
# OKX_CA_BUNDLE=
